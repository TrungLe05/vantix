# --------------------------- Backend ---------------------------
# Biến dành riêng cho service Java (IDE run config / export trước khi chạy).
# Danh sách đầy đủ kèm giải thích và biến cho docker-compose: ../.env.example

#database
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

#oauth2
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
FRONTEND_CALLBACK_URL=http://localhost:3000/auth-callback

#gateway CORS
FRONTEND_ORIGIN=http://localhost:3000

#system
DEFAULT_ADMIN_USER_NAME=<DEFAULT_ADMIN_USER_NAME>
DEFAULT_ADMIN_PASSWORD=<DEFAULT_ADMIN_PASSWORD>
DEFAULT_STAFF_USER_NAME=<DEFAULT_STAFF_USER_NAME>
DEFAULT_STAFF_PASSWORD=<DEFAULT_STAFF_PASSWORD>
DEFAULT_BUYER_PASSWORD=<DEFAULT_BUYER_PASSWORD>
OTP_HMAC_SECRET=<OTP_HMAC_SECRET>
JWT_SECRET_KEY=<JWT_SECRET_KEY>

#tùy chọn (có giá trị mặc định trong application.yaml)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PRODUCT_SERVICE_URL=http://localhost:9003/api

# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Tên biến khớp với docker-compose.yml và application.yaml của các service (13/11/2026).
# Service Spring không tự đọc file .env: export biến vào môi trường/IDE run config trước khi chạy.

# --- PostgreSQL (docker-compose, mọi service Java) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- pgAdmin (docker-compose) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# --- Kafka (docker-compose) ---
# Sinh bằng: docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=
# Tùy chọn, mặc định localhost:9092 (user/product/order)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis (tùy chọn, mặc định localhost:6379; user/order) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (user-service + api-gateway, PHẢI cùng giá trị) ---
# Tối thiểu 32 byte. TTL cấu hình trong application.yaml (15m / 7d), không qua biến môi trường.
JWT_SECRET_KEY=change_me_at_least_32_bytes_long_secret

# --- OTP (user-service) ---
# Secret HMAC-SHA256 để hash OTP trong Redis, khác JWT_SECRET_KEY
OTP_HMAC_SECRET=change_me_another_random_secret

# --- Frontend / CORS ---
# Origin được phép gọi Gateway (api-gateway globalcors)
FRONTEND_ORIGIN=http://localhost:3000
# Trang frontend nhận ?code= hoặc ?error= sau đăng nhập Google (user-service)
FRONTEND_CALLBACK_URL=http://localhost:3000/auth-callback

# --- Google OAuth2 (user-service) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Tài khoản seed dev (user-service, ApplicationRunConfig) ---
# Username là email đăng nhập. Chỉ dùng cho dev, không dùng mật khẩu thật.
DEFAULT_ADMIN_USER_NAME=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_me_1
DEFAULT_STAFF_USER_NAME=staff@example.com
DEFAULT_STAFF_PASSWORD=change_me_2
# Mật khẩu chung cho buyer0..buyer4@gmail.com
DEFAULT_BUYER_PASSWORD=change_me_3

# --- order-service (tùy chọn) ---
# Base URL product-service mà Order gọi qua OpenFeign, mặc định http://localhost:9003/api
PRODUCT_SERVICE_URL=http://localhost:9003/api

# --- Chưa dùng trong code (dự kiến) ---
# P5: SMTP gửi email (notification-service)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# P4: Stripe (test mode, payment-service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
